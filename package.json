{
  "name": "inside",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "bonto-start": "npx --yes pnpm@10.25.0 install && npx --yes pnpm@10.25.0 --filter @inside/database exec prisma generate && npx --yes pnpm@10.25.0 --filter api build && node apps/api/dist/main.js"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
