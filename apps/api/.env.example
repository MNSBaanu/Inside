DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inside_dev?schema=public
# E2E uses inside_test by default (override with DATABASE_URL_TEST if needed)
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/inside_test?schema=public
NODE_ENV=development
# Dev only: return raw email-verify/reset tokens in API responses (ignored in production)
EXPOSE_DEV_AUTH_TOKENS=true
JWT_SECRET=dev-only-replace-me-abcdefghijklmnopqrstuvwxyz0123456789
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=30
CORS_ORIGIN=http://localhost:3000
PORT=3001
# Uploads: from the Cloudinary dashboard, format cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Payments: Stripe test-mode secret key (sk_test_...)
STRIPE_SECRET_KEY=
# Add later: STRIPE_WEBHOOK_SECRET, SENTRY_DSN
