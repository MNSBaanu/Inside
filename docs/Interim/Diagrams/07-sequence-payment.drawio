<mxfile host="Electron" agent="Cursor">
  <diagram name="Sequence Diagram - Milestone Payment" id="sequence-payment">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Actors (stick figures) -->
        <mxCell id="actor-client" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Client" vertex="1">
          <mxGeometry x="70" y="20" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor-designer" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Designer" vertex="1">
          <mxGeometry x="250" y="20" width="40" height="70" as="geometry" />
        </mxCell>

        <!-- System participants (boxes) -->
        <mxCell id="box-web" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Web / Mobile App" vertex="1">
          <mxGeometry x="420" y="30" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-api" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="NestJS API" vertex="1">
          <mxGeometry x="620" y="30" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-db" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="PostgreSQL" vertex="1">
          <mxGeometry x="820" y="30" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-stripe" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Stripe" vertex="1">
          <mxGeometry x="1020" y="30" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- Lifelines (dashed) -->
        <mxCell id="ll-client" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="110" as="sourcePoint" />
            <mxPoint x="90" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-designer" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="110" as="sourcePoint" />
            <mxPoint x="270" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-web" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="80" as="sourcePoint" />
            <mxPoint x="480" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-api" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="80" as="sourcePoint" />
            <mxPoint x="670" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-db" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="80" as="sourcePoint" />
            <mxPoint x="870" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-stripe" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="80" as="sourcePoint" />
            <mxPoint x="1070" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Messages: solid = call, dashed = return -->
        <mxCell id="m1" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="1. Upload deliverable for current stage">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="150" as="sourcePoint" />
            <mxPoint x="480" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="2. Forward to API">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="210" as="sourcePoint" />
            <mxPoint x="670" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="3. Save file + create version">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="270" as="sourcePoint" />
            <mxPoint x="870" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="4. Return success">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="330" as="sourcePoint" />
            <mxPoint x="670" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="5. Notify: Stage ready for review">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="390" as="sourcePoint" />
            <mxPoint x="90" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="6. View deliverable">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="450" as="sourcePoint" />
            <mxPoint x="480" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="7. Approve stage">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="510" as="sourcePoint" />
            <mxPoint x="480" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="8. Submit approval">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="570" as="sourcePoint" />
            <mxPoint x="670" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="9. Validate stage + create payment intent">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="630" as="sourcePoint" />
            <mxPoint x="870" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="10. Record intent (pending)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="690" as="sourcePoint" />
            <mxPoint x="670" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="11. Create Checkout Session">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="750" as="sourcePoint" />
            <mxPoint x="1070" y="750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="12. Payment UI / confirm">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="810" as="sourcePoint" />
            <mxPoint x="90" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="13. Webhook: payment succeeded → release">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="870" as="sourcePoint" />
            <mxPoint x="670" y="870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
