        </mxCell>
        <mxCell id="m3" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="3. Save Proposal (status: PENDING)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="270" as="sourcePoint" />
            <mxPoint x="870" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="4. Confirm saved">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="320" as="sourcePoint" />
            <mxPoint x="670" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="5. Notify client: New proposal">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="380" as="sourcePoint" />
            <mxPoint x="1070" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="6. Open comparison / request detail">
          <mxGeometry relative="1" as="geometry">
