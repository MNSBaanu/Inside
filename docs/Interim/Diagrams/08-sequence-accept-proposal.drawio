        </mxCell>
        <mxCell id="m2" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="2. POST /proposals">
          <mxGeometry relative="1" as="geometry">
