        </mxCell>
        <mxCell id="m12" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="12. ACCEPTED + reject others; create Project + 5 Stages">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="800" as="sourcePoint" />
            <mxPoint x="870" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="13. Notify designer: Proposal accepted">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="860" as="sourcePoint" />
            <mxPoint x="1070" y="860" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="14. Redirect to Project Workspace">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="910" as="sourcePoint" />
            <mxPoint x="90" y="910" as="targetPoint" />
          </mxGeometry>
