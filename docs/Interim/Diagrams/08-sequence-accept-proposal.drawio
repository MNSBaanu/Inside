<mxfile host="Electron" agent="Cursor">
  <diagram name="Sequence Diagram - Accept Proposal" id="sequence-accept-proposal">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Actors (stick figures) -->
        <mxCell id="actor-client" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Client" vertex="1">
          <mxGeometry x="70" y="20" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor-designer" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Designer" vertex="1">
          <mxGeometry x="250" y="20" width="40" height="70" as="geometry" />
        </mxCell>

        <!-- System participants -->
        <mxCell id="box-web" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Web App" vertex="1">
          <mxGeometry x="420" y="30" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-api" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="NestJS API" vertex="1">
          <mxGeometry x="620" y="30" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-db" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="PostgreSQL" vertex="1">
          <mxGeometry x="820" y="30" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-notify" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Tahoma;fontSize=11;fontStyle=1;" value="Notification" vertex="1">
          <mxGeometry x="1020" y="30" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll-client" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="110" as="sourcePoint" />
            <mxPoint x="90" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-designer" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="110" as="sourcePoint" />
            <mxPoint x="270" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-web" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="80" as="sourcePoint" />
            <mxPoint x="470" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-api" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="80" as="sourcePoint" />
            <mxPoint x="670" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-db" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="80" as="sourcePoint" />
            <mxPoint x="870" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-notify" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="80" as="sourcePoint" />
            <mxPoint x="1070" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Messages -->
        <mxCell id="m1" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="1. Submit proposal (scope, timeline, fees)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="150" as="sourcePoint" />
