          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="80" as="sourcePoint" />
            <mxPoint x="1070" y="1020" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Messages 1–9 (upload + review) -->
        <mxCell id="m1" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="1. Upload deliverable for current stage">
