        <mxCell id="m11b" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="11b. Forward reject">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="920" as="sourcePoint" />
            <mxPoint x="670" y="920" as="targetPoint" />
