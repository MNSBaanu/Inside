        <mxCell id="alt-reject" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontFamily=Tahoma;fontStyle=2;fontColor=#10739e;" value="[Reject]">
          <mxGeometry x="60" y="835" width="80" height="20" as="geometry" />
