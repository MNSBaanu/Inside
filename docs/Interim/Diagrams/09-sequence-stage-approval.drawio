        <mxCell id="m11a" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="11a. Forward approve">
