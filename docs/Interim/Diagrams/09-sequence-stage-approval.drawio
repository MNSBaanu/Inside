        <mxCell id="m9" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="9. Return files + preview URLs">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="620" as="sourcePoint" />
            <mxPoint x="270" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt frame -->
        <mxCell id="alt-frame" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#10739e;strokeWidth=1.5;dashed=1;fontFamily=Tahoma;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="alt" vertex="1">
          <mxGeometry x="50" y="660" width="1060" height="340" as="geometry" />
        </mxCell>
        <mxCell id="alt-approve" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontFamily=Tahoma;fontStyle=2;fontColor=#10739e;" value="[Approve]">
          <mxGeometry x="60" y="665" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="alt-divider" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1;">
