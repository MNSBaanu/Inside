        <mxCell id="m12b" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="12b. Stage → REJECTED; save feedback">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="960" as="sourcePoint" />
            <mxPoint x="1070" y="960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13b" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontFamily=Tahoma;fontSize=10;fontStyle=1;labelBackgroundColor=none;verticalAlign=bottom;" value="13b. Notify designer: Revision requested">
          <mxGeometry relative="1" as="geometry">
